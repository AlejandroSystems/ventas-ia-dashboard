import yaml
import pandas as pd
import numpy as np
import json
import io
from datetime import datetime, timezone
from google.cloud import storage

# -----------------------------------------------------------------------------
# 3.1 Cargar configuración y preparar Dtypes
# -----------------------------------------------------------------------------
client = storage.Client(project=PROJECT_ID)
bucket = client.bucket(BUCKET_NAME)

cfg_blob = bucket.blob(f"{PATHS['configs_dir']}config.yaml")
cfg = yaml.safe_load(cfg_blob.download_as_text())

# Validación cruzada básica
primary = cfg["models"]["primary_metric"]
if primary not in cfg["models"]["metrics"]:
    raise SystemExit(f"❌ primary_metric '{primary}' no está en metrics {cfg['models']['metrics']}")

# Mapeo de tipos de datos
schema = cfg["data"]["schema"]
DTYPE_MAP = {
    "int16": "int16",
    "int32": "int32",
    "float32": "float32",
    "string": "string",
}
pd_dtypes = {
    "store_nbr":   DTYPE_MAP[schema["store_nbr"]],
    "family":      DTYPE_MAP[schema["family"]],
    "sales":       DTYPE_MAP[schema["sales"]],
    "onpromotion": DTYPE_MAP[schema["onpromotion"]],
}
parse_dates = ["date"]
source_uri  = cfg["data"]["source_csv"]
series_keys = cfg["data"]["series_keys"]
target_col  = cfg["data"]["target"]

print("Configuración cargada OK →", source_uri)

# -----------------------------------------------------------------------------
# 3.2 Lectura optimizada del Dataset
# -----------------------------------------------------------------------------
usecols = ["date", "store_nbr", "family", "sales", "onpromotion"]

# 1) Verificar cabecera (Smoke test)
hdr = pd.read_csv(source_uri, nrows=0)
missing = [c for c in usecols if c not in hdr.columns]
if missing:
    raise SystemExit(f"❌ Faltan columnas requeridas en el CSV: {missing}")

# 2) Cargar dataset completo
print("Cargando dataset...")
df = pd.read_csv(
    source_uri,
    usecols=usecols,
    dtype=pd_dtypes,
    parse_dates=parse_dates,
    # infer_datetime_format=True,  <-- ELIMINADO (Deprecado en Pandas 2.x)
    na_values=["", "na", "NA", "null", "NULL"],
    low_memory=False,
)

# Cast explícito para categorías
df["family"] = df["family"].astype("string")

def mem_megabytes(x: pd.DataFrame) -> float:
    return x.memory_usage(deep=True).sum() / (1024**2)

print(f"Dataset cargado | Shape: {df.shape} | Memoria: {mem_megabytes(df):.2f} MiB")

# -----------------------------------------------------------------------------
# 3.3 QA Básico (Duplicados, Nulos, Rangos)
# -----------------------------------------------------------------------------
# Ordenar canónicamente
df = df.sort_values(["store_nbr", "family", "date"]).reset_index(drop=True)

# Duplicados
dup_mask = df.duplicated(subset=["store_nbr","family","date"], keep=False)
dups = df.loc[dup_mask, ["store_nbr","family","date"]].copy()

# Nulos críticos
nulls = df[["date","sales"]].isna().sum().rename("n_nulls").to_frame()

# Violaciones de rango
range_bad = {
    "sales_negatives":     int((df["sales"] < 0).sum()),
    "onpromo_negatives":   int((df["onpromotion"] < 0).sum()),
}

print(f"Duplicados encontrados: {len(dups)}")
print("Violaciones de rango:", range_bad)

# -----------------------------------------------------------------------------
# 3.4 Análisis de Cobertura Histórica y Completitud (MEJORADO)
# -----------------------------------------------------------------------------
grp = df.groupby(series_keys, as_index=False).agg(
    start=("date", "min"),
    end=("date",   "max"),
    n_rows=("date","size"),
    n_days=("date","nunique"),   # días con dato (sin contar duplicados)
)

# Ventana total en días entre la primera y la última fecha
grp["days"] = (grp["end"] - grp["start"]).dt.days + 1

# Completitud: qué proporción de días tiene realmente información
grp["completeness"] = grp["n_days"] / grp["days"]   # ~1.0 = historial completo

def coverage_level(row) -> str:
    days = row["days"]
    comp = row["completeness"]

    # Primero filtramos series rotas
    if comp < 0.85:
        return "❌ data incompleta (huecos)"
    if days < 180:
        return "❌ bloqueado (<6m)"
    if days < 365:
        return "⚠️ riesgo alto (6–12m)"
    if days < 730:
        return "✅ recomendado (12–24m)"
    if days <= 1825:
        return "🟢 óptimo (24–60m)"
    return "⚠️ antiguo/drift (>60m)"

grp["coverage_level"] = grp.apply(coverage_level, axis=1)

levels_counts = grp["coverage_level"].value_counts().to_dict()
share_ge_12m = (grp["days"] >= 365).mean() * 100

print(f"\nResumen de cobertura: {share_ge_12m:.1f}% de series tienen >= 1 año de historia.")

# -----------------------------------------------------------------------------
# 3.5 Persistencia de Reportes en GCS
# -----------------------------------------------------------------------------
ts = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
print(f"\nGuardando reportes en GCS (Timestamp: {ts})...")

# Helper para subir DF a CSV
def upload_csv(dataframe, path):
    if dataframe is None or dataframe.empty: return
    blob = bucket.blob(path)
    buf = io.StringIO()
    dataframe.to_csv(buf, index=False)
    blob.upload_from_string(buf.getvalue(), content_type="text/csv")
    print(f" -> {path}")

# 1. Reportes de QA
upload_csv(dups, f"{PATHS['reports_dir']}qa_duplicates_{ts}.csv")
upload_csv(nulls, f"{PATHS['reports_dir']}qa_nulls_{ts}.csv") # nulls es un DF del .to_frame()
upload_csv(grp,   f"{PATHS['reports_dir']}qa_coverage_{ts}.csv")

# 2. Resumen JSON
summary = {
    "rows":              int(len(df)),
    "n_series":          int(len(grp)),
    "levels_counts":     levels_counts,
    "pct_series_ge_12m": round(share_ge_12m, 2),
    "range_violations":  range_bad,
    "n_duplicates":      int(len(dups)),
}
sum_blob = bucket.blob(f"{PATHS['reports_dir']}qa_summary_{ts}.json")
sum_blob.upload_from_string(json.dumps(summary, ensure_ascii=False, indent=2), content_type="application/json")
print(f" -> {sum_blob.name}")

# -----------------------------------------------------------------------------
# 3.6 Diagnósticos para UI (Streamlit)
# -----------------------------------------------------------------------------
print("Generando diagnósticos optimizados para Streamlit...")

# A) Reporte Mensual (Tendencias macro y nulos)
df_month = df.copy()
df_month["year"]  = df_month["date"].dt.year
df_month["month"] = df_month["date"].dt.month

month_diag = (
    df_month
      .groupby(["year", "month"], as_index=False)
      .agg(
          n_rows=("date", "size"),
          n_nulls=("sales", lambda x: int(x.isna().sum()))
      )
)
upload_csv(month_diag, f"{PATHS['reports_dir']}diagnostics/month_report_{ts}.csv")

# B) Reporte por Familia (Usamos el grp que ya calculamos)
upload_csv(grp, f"{PATHS['reports_dir']}diagnostics/family_report_{ts}.csv")

print("\n✅ BLOQUE 3 FINALIZADO CON ÉXITO.")

# --- Bloque 3.5 (OPTIMIZADO): Análisis de Distribución del Target (Sampling) ---
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
from scipy.stats import skew, kurtosis

print("📊 Iniciando Estudio de Distribución (Optimizado con Muestreo)...")

# 1. Muestreo Estratégico (Sampling)
# No necesitamos graficar 3 millones de puntos. Con 50k es suficiente para ver la forma.
# Usamos random_state para que el gráfico sea reproducible.
SAMPLE_SIZE = 50000

if len(df) > SAMPLE_SIZE:
    df_sample = df.sample(n=SAMPLE_SIZE, random_state=42).copy()
    print(f"   ℹ️ Usando una muestra aleatoria de {SAMPLE_SIZE} filas (de {len(df)}) para agilizar la visualización.")
else:
    df_sample = df.copy()

# 2. Limpieza de Ceros para Visualización
# Las ventas en 0 no nos interesan para ver la "forma" de la campana, solo ensucian el gráfico.
# Calculamos qué % son ceros, pero los quitamos del dibujo.
zeros_pct = (df['sales'] == 0).mean() * 100
y_viz = df_sample[df_sample['sales'] > 0]['sales'] # Solo ventas positivas para el gráfico

print(f"   ℹ️ El {zeros_pct:.2f}% de los registros son ventas en 0 (días sin venta).")
print(f"   ℹ️ Visualizando distribución de ventas > 0...")

# 3. Transformación (Log1p) sobre la muestra
y_viz_log = np.log1p(y_viz)

# 4. Cálculo de Estadísticas (Sobre TODOS los datos, no solo la muestra, para precisión)
# Log1p sobre todo el dataset original (filtrando ceros para no romper skewness)
y_full_nonzero = df[df['sales'] > 0]['sales'].dropna()
skew_raw = skew(y_full_nonzero)
skew_log = skew(np.log1p(y_full_nonzero))

# 5. Configurar Gráficos
fig, ax = plt.subplots(1, 2, figsize=(18, 6))

# --- Gráfico A: Distribución Original (Muestra > 0) ---
sns.histplot(y_viz, bins=50, kde=True, color='salmon', ax=ax[0])
ax[0].set_title(f"Distribución Ventas > 0 (Muestra)", fontsize=14)
ax[0].set_xlabel("Ventas (USD/Unidades)")
ax[0].set_ylabel("Frecuencia (Muestra)")

# Texto estadístico A
stats_text_a = f"Asimetría (Skew): {skew_raw:.2f}\n(Calculado sobre total)"
ax[0].text(0.95, 0.95, stats_text_a, transform=ax[0].transAxes,
           fontsize=12, verticalalignment='top', horizontalalignment='right',
           bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))

# --- Gráfico B: Distribución Logarítmica (Muestra > 0) ---
sns.histplot(y_viz_log, bins=50, kde=True, color='teal', ax=ax[1])
ax[1].set_title(f"Distribución Log-Transform (Log1p)", fontsize=14)
ax[1].set_xlabel("Log(Ventas)")
ax[1].set_ylabel("Frecuencia (Muestra)")

# Texto estadístico B
stats_text_b = f"Asimetría (Skew): {skew_log:.2f}\n(Calculado sobre total)"
ax[1].text(0.95, 0.95, stats_text_b, transform=ax[1].transAxes,
           fontsize=12, verticalalignment='top', horizontalalignment='right',
           bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))

plt.tight_layout()
plt.show()

# 6. Conclusión Automática
print("\n📝 CONCLUSIÓN DEL ESTUDIO:")
print("-" * 60)
if abs(skew_log) < abs(skew_raw):
    print("✅ La transformación logarítmica MEJORA la forma de la distribución.")
    print(f"   - Asimetría bajó de {skew_raw:.2f} a {skew_log:.2f}.")
    print("   - INTERPRETACIÓN: Modelar sobre log-ventas podría estabilizar picos y colas largas.")
    print("   - NOTA: En este proyecto mantenemos el target en escala original por simplicidad operativa.")
else:
    print("⚠️ La transformación no ayudó significativamente.")

print("-" * 60)

