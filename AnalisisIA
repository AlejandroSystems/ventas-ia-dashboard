        full["is_weekend"] = (full["weekday"] >= 5).astype("int8")
    else:
        tmp_weekday = full["date"].dt.weekday
        full["is_weekend"] = (tmp_weekday >= 5).astype("int8")

# Asegurar tipo string para 'family' por robustez
full["family"] = full["family"].astype("string")

# 5. Generar Lags y Rolling Windows
print("Generando lags y rolling windows (esto puede tardar un poco)...")

for lag in lags:
    full[f"lag_{lag}"] = full.groupby(series_keys)[target_col].shift(lag)

for r in rolls:
    w, fn = r["window"], r["fn"]
    base = full.groupby(series_keys)[target_col].shift(1)

    if fn == "mean":
        full[f"roll_mean_{w}"] = base.rolling(window=w, min_periods=1).mean()
    elif fn == "sum":
        full[f"roll_sum_{w}"] = base.rolling(window=w, min_periods=1).sum()

# 6. Guardar el dataset completo procesado en Parquet
full.to_parquet(features_parquet_uri, index=False)

print("✅ Feature Engineering completado.")
print(f"Dataset con features guardado en: {features_parquet_uri}")
print(f"Shape final: {full.shape}")
print(full.head(3))

