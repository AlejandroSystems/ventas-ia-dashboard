# 2.2 Esquema Pydantic para validar config.yaml

class ProjectCfg(BaseModel):
    id: str
    bucket: str
    region: str

class DataSchema(BaseModel):
    date: Literal["datetime64[ns]"]
    store_nbr: Literal["int32"]
    family: Literal["string"]
    sales: Literal["float32"]
    onpromotion: Literal["int16"]

class DataCfg(BaseModel):
    source_csv: str
    schema: DataSchema
    series_keys: List[Literal["store_nbr", "family"]]
    target: Literal["sales"]

class SplitCfg(BaseModel):
    cutoff_date: str
    forecast_horizon_days: int

    @field_validator("cutoff_date")
    @classmethod
    def check_date_format(cls, v):
        import re
        if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", v):
            raise ValueError("cutoff_date debe tener formato YYYY-MM-DD")
        return v

    @field_validator("forecast_horizon_days")
    @classmethod
    def check_horizon(cls, v):
        if v <= 0 or v > 365:
            raise ValueError("forecast_horizon_days debe estar entre 1 y 365")
        return v

class RollingCfg(BaseModel):
    window: int
    fn: str

class FeaturesCfg(BaseModel):
    calendar: List[Literal["year", "month", "weekday", "is_weekend"]]
    lags: List[int]
    rolling: List[RollingCfg]
    use_onpromotion: bool
    categoricals: List[Literal["store_nbr", "family"]]

    @field_validator("lags")
    @classmethod
    def check_lags(cls, v):
        if any(x <= 0 for x in v):
            raise ValueError("Todos los lags deben ser > 0")
        return v

class ModelsCfg(BaseModel):
    baselines: List[Literal["naive_t1", "naive_t7"]]
    candidates: List[Literal["linear", "random_forest", "lightgbm", "xgboost"]]
    primary_metric: Literal["mae", "rmse", "r2"]
    metrics: List[Literal["mae", "rmse", "r2"]]

class ConfigSchema(BaseModel):
    project: ProjectCfg
    data: DataCfg
    split: SplitCfg
    features: FeaturesCfg
    models: ModelsCfg
    paths: Dict[str, str]

# 2.3 Validar el YAML subido
