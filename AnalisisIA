import pandas as pd
import yaml
import numpy as np
from google.cloud import storage

# 1. Cargar configuración
# Asumimos que PROJECT_ID, BUCKET_NAME y PATHS están definidos en memoria (del Bloque 1 y 2)
client = storage.Client(project=PROJECT_ID)
bucket = client.bucket(BUCKET_NAME)

cfg = yaml.safe_load(bucket.blob(f"{PATHS['configs_dir']}config.yaml").download_as_text())
CUTOFF_DATE = pd.Timestamp(cfg["split"]["cutoff_date"])
target_col  = cfg["data"]["target"]
cat_cols    = cfg["features"]["categoricals"]
series_keys = cfg["data"]["series_keys"]

# 2. Leer el Parquet procesado (Ruta dinámica desde config)
full_parquet_uri = cfg["paths"]["features_parquet"]
print(f"📂 Leyendo dataset procesado desde: {full_parquet_uri}")
full = pd.read_parquet(full_parquet_uri)

# 3. Definir columnas de features dinámicamente
excluded = ["date", target_col, "id"]
all_cols = full.columns.tolist()
feat_cols = [c for c in all_cols if c not in excluded]

# 4. Split Temporal (Train / Test)
print(f"✂️ Realizando split temporal en: {CUTOFF_DATE}")
train = full[full["date"] <= CUTOFF_DATE].copy()
test  = full[full["date"] >  CUTOFF_DATE].copy()

# 5. Limpieza de Nulos en Train (causados por Lags)
lag_cols = [c for c in feat_cols if c.startswith("lag_") or c.startswith("roll_")]
train = train.dropna(subset=lag_cols)

# 6. Preparar X e y
X_train = train[feat_cols].copy()
y_train = train[target_col].astype("float32").copy()

X_test  = test[feat_cols].copy()
# 🛡️ SEGURIDAD: Rellenar nulos en Test con 0 para evitar crash en sklearn
X_test = X_test.fillna(0)
y_test  = test[target_col].astype("float32").copy()

print("-" * 30)
print(f"Train dates: {train['date'].min().date()} -> {train['date'].max().date()}")
print(f"Test dates : {test['date'].min().date()} -> {test['date'].max().date()}")
print(f"X_train shape: {X_train.shape} | y_train shape: {y_train.shape}")
print(f"X_test shape : {X_test.shape}  | y_test shape : {y_test.shape}")

# --- Bloque 5.3: Baselines temporales ---
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

def evaluate(y_true, y_pred):
    mae  = mean_absolute_error(y_true, y_pred)
    mse  = mean_squared_error(y_true, y_pred)
    rmse = np.sqrt(mse)
    r2   = r2_score(y_true, y_pred)
    return {"MAE": mae, "RMSE": rmse, "R2": r2}

print("\n📉 Calculando Baselines...")
tmp = full.sort_values(series_keys + ["date"]).copy()

# Naive T1
tmp["naive_t1"] = tmp.groupby(series_keys)[target_col].shift(1)
pred_t1 = tmp.loc[tmp["date"] > CUTOFF_DATE, "naive_t1"].fillna(0).to_numpy(dtype="float32")
base_t1 = evaluate(y_test, pred_t1)

# Naive T7
tmp["naive_t7"] = tmp.groupby(series_keys)[target_col].shift(7)
pred_t7 = tmp.loc[tmp["date"] > CUTOFF_DATE, "naive_t7"].fillna(0).to_numpy(dtype="float32")
base_t7 = evaluate(y_test, pred_t7)

print(f"   Baseline Naive T1: {base_t1}")
print(f"   Baseline Naive T7: {base_t7}")

# --- Bloque 5.4 (MODO PRO - GPU): Modelado Avanzado ---
from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import OneHotEncoder
from sklearn.pipeline import Pipeline
from sklearn.linear_model import LinearRegression
from sklearn.ensemble import RandomForestRegressor
from xgboost import XGBRegressor
import matplotlib.pyplot as plt

num_features = [c for c in feat_cols if c not in cat_cols]
cat_features = cat_cols

# Preprocesador
preprocess = ColumnTransformer(
    transformers=[
        ("num", "passthrough", num_features),
        ("cat", OneHotEncoder(handle_unknown="ignore", sparse_output=True), cat_features),
    ],
    remainder="drop",
)

results = []
print("\n🚀 Iniciando entrenamiento (Configuración PRO)...")

# 1) Linear Regression
print("   🔹 Entrenando Linear Regression...")
pipe_lin = Pipeline([("prep", preprocess), ("model", LinearRegression())])
pipe_lin.fit(X_train, y_train)
pred_lin = pipe_lin.predict(X_test)
res_lin  = evaluate(y_test, pred_lin)
results.append(("Linear", res_lin))

# 2) Random Forest (Potenciado para Colab Pro)
print("   🔹 Entrenando Random Forest (500 árboles)...")
pipe_rf = Pipeline([
    ("prep", preprocess),
    ("model", RandomForestRegressor(
        n_estimators=500,     # Más árboles
        max_depth=20,         # Más profundidad
        min_samples_leaf=4,
        n_jobs=-1,
        random_state=42,
        verbose=0
    )),
])
pipe_rf.fit(X_train, y_train)
pred_rf = pipe_rf.predict(X_test)
res_rf  = evaluate(y_test, pred_rf)
results.append(("RandomForest", res_rf))

# 3) XGBoost (GPU ACTIVADA)
print("   🔹 Entrenando XGBoost (Aceleración GPU)...")
pipe_xgb = Pipeline([
    ("prep", preprocess),
    ("model", XGBRegressor(
        n_estimators=1000,      # Alta capacidad
        max_depth=10,
        learning_rate=0.02,     # Aprendizaje fino
        subsample=0.8,
        colsample_bytree=0.8,
        device="cuda",          # 👈 GPU NVIDIA T4/A100
        tree_method="hist",
        random_state=42,
        n_jobs=-1
    )),
])

# Fallback automático a CPU si no hay GPU
try:
    pipe_xgb.fit(X_train, y_train)
except Exception as e:
    print(f"⚠️ GPU no detectada o error ({e}). Cambiando a CPU...")
    pipe_xgb.named_steps['model'].set_params(device="cpu")
    pipe_xgb.fit(X_train, y_train)

pred_xgb = pipe_xgb.predict(X_test)
res_xgb  = evaluate(y_test, pred_xgb)
results.append(("XGBoost", res_xgb))

print("\n🏆 Resultados Comparativos:")
for name, m in results:
    print(f"{name:12s} | MAE: {m['MAE']:.4f} | RMSE: {m['RMSE']:.4f} | R2: {m['R2']:.4f}")

# Feature Importance Rápido (XGBoost)
print("\n📊 Importancia de Características (Top 10 - XGBoost):")
try:
    imp = pipe_xgb.named_steps['model'].feature_importances_
    # Recuperar nombres (trick para OneHot)
    ohe = pipe_xgb.named_steps['prep'].named_transformers_['cat']
    feat_names = num_features + list(ohe.get_feature_names_out(cat_features))

    df_imp = pd.DataFrame({"feature": feat_names, "importance": imp}).sort_values("importance", ascending=False).head(10)
    print(df_imp)
except:
    print("(No se pudo extraer feature importance detallado)")


